{
  "info": {
    "name": "TaskFlow Autenticação",
    "description": "Cenários da atividade de autenticação. Somente dados fictícios.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Cadastro válido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Resposta em JSON', () => pm.response.to.be.json);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/auth/register.php",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register.php"
          ]
        },
        "description": "Objetivo: cadastrar Ana Teste (ana@teste.com), dados fictícios. Esperado: 201, sem senha/senha_hash na resposta.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ana Teste\",\n  \"email\": \"ana@teste.com\",\n  \"senha\": \"senha12345\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
